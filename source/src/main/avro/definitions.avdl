@namespace("com.sixgroup.refit.observability.topic.item")
protocol ItemProtocol {
    record ItemId {
        string itemId;
    }
    record FileInfo {
        string fileName;
        string fileUrl;
    }
    record ItemCommand {
        string itemId;
        string itemType;
        string command;
        string itemDate;
        timestamp_ms creationTimestamp;
        FileInfo fileInfo;
    }
}
